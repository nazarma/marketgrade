{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marketgrade",
  "version": "../../package.json",
  "identifier": "io.github.nazarma.marketgrade",
  "build": {
    "beforeDevCommand": "dotnet build src/backend/Marketgrade.Backend && pnpm --dir src/ui dev",
    "beforeBuildCommand": "pnpm --dir src/ui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Marketgrade",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Nazar Martincenco",
    "copyright": "Copyright (c) 2026 Nazar Martincenco",
    "license": "MIT",
    "category": "Finance",
    "shortDescription": "Measures market data health on crypto exchanges",
    "longDescription": "Marketgrade measures how good the public market data of Kraken, Coinbase and Binance is: delay, gaps and correctness checks per exchange, live on this computer.",
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.txt"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
